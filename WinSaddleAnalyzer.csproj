<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsUraPlugin>true</IsUraPlugin>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>2026.03.04</Version>

    <!-- URA 插件元数据：供发布 manifest 使用 -->
    <PluginInternalName>WinSaddleAnalyzer</PluginInternalName>
    <PluginDisplayName>显示殿堂马&amp;好友种马信息</PluginDisplayName>
    <PluginAuthor>离披</PluginAuthor>
    <PluginRepositoryUrl>https://github.com/URA-Plugins/WinSaddleAnalyzer</PluginRepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="i18n\ParseFriendSearchResponse.Designer.cs">
      <DependentUpon>ParseFriendSearchResponse.resx</DependentUpon>
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
    </Compile>
    <Compile Update="i18n\ParseTrainedCharaLoadResponse.Designer.cs">
      <DependentUpon>ParseTrainedCharaLoadResponse.resx</DependentUpon>
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="i18n\ParseFriendSearchResponse.en-US.resx">
      <SubType>Designer</SubType>
    </EmbeddedResource>
    <EmbeddedResource Update="i18n\ParseFriendSearchResponse.ja-JP.resx">
      <SubType>Designer</SubType>
    </EmbeddedResource>
    <EmbeddedResource Update="i18n\ParseFriendSearchResponse.resx">
      <SubType>Designer</SubType>
      <LastGenOutput>ParseFriendSearchResponse.Designer.cs</LastGenOutput>
      <Generator>PublicResXFileCodeGenerator</Generator>
    </EmbeddedResource>
    <EmbeddedResource Update="i18n\ParseFriendSearchResponse.zh-CN.resx">
      <SubType>Designer</SubType>
    </EmbeddedResource>
    <EmbeddedResource Update="i18n\ParseTrainedCharaLoadResponse.resx">
      <LastGenOutput>ParseTrainedCharaLoadResponse.Designer.cs</LastGenOutput>
      <Generator>PublicResXFileCodeGenerator</Generator>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="UmamusumeResponseAnalyzer" Version="*" PrivateAssets="all" />
  </ItemGroup>

</Project>
